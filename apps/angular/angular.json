{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "lab": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": [
              "style.css"
            ],
            "outputPath": "dist",
            "baseHref": "/"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "lab:build"
          }
        }
      }
    }
  }
}
